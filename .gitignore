.remember/
.DS_Store
# raw and confidential data never goes to GitHub; only the hash manifest is kept
data/raw/*
!data/raw/MANIFEST.sha256
!data/raw/.gitkeep
data/interim/
# external word lists are placed by hand after a licence check and are never committed
data/external/
data/derived/*.csv
data/derived/*.html
*.zip
*.xlsx
*.docx
.env
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
